# Copy to .env (chmod 600) and adjust. NEVER commit the real .env.
# --- host ports ---
API_HOST_PORT=8080
SONAR_HOST_PORT=9000
GRAFANA_HOST_PORT=3001
PROM_HOST_PORT=9090
BLACKBOX_HOST_PORT=9115

# --- app ---
APP_STAGE=dev
LOG_LEVEL=INFO
SERVICE_NAME=chalice-api
METRICS_ENABLED=true
DEMO_ENDPOINTS_ENABLED=true
DEMO_MAX_DELAY_SECONDS=5
TRAFFIC_RPS=5
TRAFFIC_DURATION=60

# --- postgres (sonar) ---
POSTGRES_DB=sonar
POSTGRES_USER=sonar
POSTGRES_PASSWORD=change-me-strong

# --- grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong

# --- sonar bootstrap ---
SONAR_PROJECT_KEY=chalice-devops-lab
SONAR_PROJECT_NAME=AWS Chalice DevOps Lab
SONAR_QUALITY_GATE=chalice-devops-lab-gate
SONAR_STARTUP_TIMEOUT=300
SONAR_POLL_INTERVAL=5
SONAR_TOKEN_NAME=lab-scanner-token
