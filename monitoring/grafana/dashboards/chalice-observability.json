{
  "uid": "chalice-observability",
  "title": "AWS Chalice API — Observability",
  "tags": ["chalice", "devsecops-lab"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "API Availability (synthetic)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "chalice-prom" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 99 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "area" },
      "targets": [ { "refId": "A", "expr": "avg_over_time(avg(probe_success{job=\"blackbox-http\"})[5m:]) * 100" } ]
    },
    {
      "id": 2, "type": "stat", "title": "Health Status (/health)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "chalice-prom" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["last"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none" },
      "targets": [ { "refId": "A", "expr": "probe_success{job=\"blackbox-http\", endpoint=\"health\"}" } ]
    },
    {
      "id": 3, "type": "stat", "title": "Readiness Status (/ready)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "chalice-prom" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "NOT READY", "color": "red" }, "1": { "text": "READY", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["last"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none" },
      "targets": [ { "refId": "A", "expr": "probe_success{job=\"blackbox-http\", endpoint=\"ready\"}" } ]
    },
    {
      "id": 4, "type": "bargauge", "title": "Endpoint Comparison (success last 5m)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "chalice-prom" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 0.99 } ] } }, "overrides": [] },
      "options": { "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "horizontal" },
      "targets": [ { "refId": "A", "expr": "avg_over_time(probe_success{job=\"blackbox-http\"}[5m])", "legendFormat": "{{endpoint}}" } ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Synthetic HTTP Response Time (Blackbox)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "chalice-prom" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "probe_duration_seconds{job=\"blackbox-http\"}", "legendFormat": "{{endpoint}}" } ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Probe Success Rate (per endpoint, 5m avg)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "chalice-prom" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": true } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "avg_over_time(probe_success{job=\"blackbox-http\"}[5m])", "legendFormat": "{{endpoint}}" } ]
    },
    {
      "id": 7, "type": "timeseries", "title": "HTTP Probe Status Codes",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "chalice-prom" },
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": true } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "probe_http_status_code{job=\"blackbox-http\"}", "legendFormat": "{{endpoint}}" } ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Probe Duration (DNS/TCP/TLS/processing breakdown)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "chalice-prom" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "probe_dns_lookup_time_seconds{job=\"blackbox-http\"}", "legendFormat": "dns {{endpoint}}" },
        { "refId": "B", "expr": "probe_tcp_connect_time_seconds{job=\"blackbox-http\"}", "legendFormat": "tcp {{endpoint}}" },
        { "refId": "C", "expr": "probe_duration_seconds{job=\"blackbox-http\"}", "legendFormat": "total {{endpoint}}" }
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "Monitoring Target Health (up)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "chalice-prom" },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "max": 1, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "spanNulls": true } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "up", "legendFormat": "{{job}} {{instance}}" } ]
    },
    {
      "id": 10, "type": "timeseries", "title": "Application Request Rate (internal /metrics)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "chalice-prom" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (route) (rate(chalice_http_requests_total[2m]))", "legendFormat": "{{route}}" } ]
    },
    {
      "id": 11, "type": "timeseries", "title": "Application Error Rate (internal 5xx)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "chalice-prom" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (route) (rate(chalice_http_requests_total{status=~\"5..\"}[2m]))", "legendFormat": "5xx {{route}}" },
        { "refId": "B", "expr": "sum by (route) (rate(chalice_http_requests_total{status=~\"4..\"}[2m]))", "legendFormat": "4xx {{route}}" }
      ]
    },
    {
      "id": 12, "type": "timeseries", "title": "Application Latency p50/p95 (internal histogram)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "chalice-prom" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le, route) (rate(chalice_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50 {{route}}" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(chalice_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{route}}" }
      ]
    }
  ]
}
